{{#resume.basics}}
<header id="header">
  <h1 class="name">{{name}}</h1>
  {{#if label}}<h2 class="label">{{label}}</h2>{{/if}}

  <div id="contact">
    {{#location}}
    <span class="location">{{#if address}}{{address}}, {{/if}}{{#if city}}{{city}}{{/if}}{{#if region}}, {{region}}{{/if}}{{#if countryCode}}, {{countryCode}}{{/if}}</span>
    {{/location}}
    {{#if email}}<a href="mailto:{{email}}">{{email}}</a>{{/if}}
    {{#if phone}}<a href="tel:{{phone}}">{{phone}}</a>{{/if}}
    {{#if website}}<a target="_blank" rel="noopener" href="{{website}}">{{website}}</a>{{/if}}
    {{#each profiles}}
      {{#if url}}<a target="_blank" rel="noopener" href="{{url}}">{{network}}</a>{{else}}<span>{{network}}: {{username}}</span>{{/if}}
    {{/each}}
  </div>
</header>

{{#if summary}}
<section class="section">
  <div class="main-summary">{{paragraphSplit summary}}</div>
</section>
{{/if}}
{{/resume.basics}}
