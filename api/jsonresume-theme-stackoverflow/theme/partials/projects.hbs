{{#if resume.projects.length}}
<section class="section">
  <h2 class="section-title">Projects</h2>
  <div id="projects">
    {{#each resume.projects}}
    <article class="entry">
      <header class="entry-head">
        <h3 class="entry-title">
          <span class="position">{{name}}</span>
          {{#if entity}}<span class="company">{{entity}}</span>{{/if}}
        </h3>
        {{#if startDate}}
        <div class="date">{{MY startDate}}{{#if endDate}} – {{MY endDate}}{{/if}}</div>
        {{/if}}
      </header>
      {{#if url}}
      <div class="meta">{{icon "link"}}<a target="_blank" rel="noopener" href="{{url}}">{{url}}</a></div>
      {{/if}}
      {{#if summary}}<div class="summary">{{paragraphSplit summary}}</div>{{/if}}
      {{#if highlights.length}}
      <ul class="highlights">
        {{#each highlights}}<li>{{.}}</li>{{/each}}
      </ul>
      {{/if}}
      {{#if keywords.length}}
      <p class="tech"><span class="tech-label">Tech:</span> {{#each keywords}}{{.}}{{#unless @last}}, {{/unless}}{{/each}}</p>
      {{/if}}
    </article>
    {{/each}}
  </div>
</section>
{{/if}}
