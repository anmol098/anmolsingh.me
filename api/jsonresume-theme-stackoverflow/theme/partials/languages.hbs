{{#if resume.languages.length}}
<section class="section">
  <h2 class="section-title">Languages</h2>
  <ul id="languages">
    {{#each resume.languages}}
    <li class="lang"><span class="language">{{language}}</span>{{#if fluency}} <span class="fluency">({{fluency}})</span>{{/if}}</li>
    {{/each}}
  </ul>
</section>
{{/if}}
