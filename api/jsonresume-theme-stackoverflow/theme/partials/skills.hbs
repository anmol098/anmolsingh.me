{{#if resume.skills.length}}
<section class="section">
  <h2 class="section-title">Skills</h2>
  <ul id="skills">
    {{#each resume.skills}}
    <li class="skill-row">
      <span class="name">{{name}}:</span>
      <span class="keywords">{{#each keywords}}{{.}}{{#unless @last}}, {{/unless}}{{/each}}</span>
    </li>
    {{/each}}
  </ul>
</section>
{{/if}}
