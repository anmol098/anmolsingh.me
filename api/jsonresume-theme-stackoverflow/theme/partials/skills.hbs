{{#if resume.skills.length}}
<section class="section">
  <h2 class="section-title">Skills</h2>
  <div id="skills">
    {{#each resume.skills}}
    <div class="skill-row">
      <h3 class="name">{{name}}</h3>
      {{#if keywords.length}}
      <ul class="keywords">
        {{#each keywords}}<li>{{.}}</li>{{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
{{/if}}
