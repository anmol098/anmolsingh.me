{{#if resume.work.length}}
<section class="section">
  <h2 class="section-title">Work Experience</h2>
  <div id="work">
    {{#each resume.work}}
    <article class="entry">
      <header class="entry-head">
        <h3 class="entry-title">
          <span class="position">{{position}}</span>
          <span class="company">{{name}}</span>
        </h3>
        <div class="date">{{#if startDate}}{{MY startDate}}{{/if}} – {{#if endDate}}{{MY endDate}}{{else}}Present{{/if}}</div>
      </header>
      {{#location}}{{#if city}}
      <div class="meta">{{icon "location"}}<span>{{city}}{{#if countryCode}}, {{countryCode}}{{/if}}</span></div>
      {{/if}}{{/location}}
      {{#if highlights.length}}
      <ul class="highlights">
        {{#each highlights}}<li>{{.}}</li>{{/each}}
      </ul>
      {{/if}}
    </article>
    {{/each}}
  </div>
</section>
{{/if}}
