{{#if resume.education.length}}
<section class="section">
  <h2 class="section-title">Education</h2>
  <div id="education">
    {{#each resume.education}}
    <article class="entry">
      <header class="entry-head">
        <h3 class="entry-title">
          <span class="position">{{studyType}}{{#if area}}, {{area}}{{/if}}</span>
          <span class="company">{{institution}}</span>
        </h3>
        <div class="date">{{#if startDate}}{{Y startDate}}{{/if}} – {{#if endDate}}{{Y endDate}}{{else}}Present{{/if}}</div>
      </header>
      {{#if gpa}}<div class="meta"><span>Grade: {{gpa}}</span></div>{{/if}}
      {{#if courses.length}}
      <p class="tech"><span class="tech-label">Courses:</span> {{#each courses}}{{.}}{{#unless @last}}, {{/unless}}{{/each}}</p>
      {{/if}}
      {{#if summary}}<div class="summary">{{paragraphSplit summary}}</div>{{/if}}
    </article>
    {{/each}}
  </div>
</section>
{{/if}}
